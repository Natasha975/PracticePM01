<Window x:Class="Library.AddEditReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        mc:Ignorable="d"
        Title="Библиотека" Height="450" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="AUTO"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ФИО:" Margin="0,0,0,5"/>
        <TextBox x:Name="FullNameTB" Grid.Row="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Номер читательского билета:" Margin="0,0,0,5"/>
        <TextBox x:Name="CardNumberTB" Grid.Row="3" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Адрес:" Margin="0,0,0,5"/>
        <TextBox x:Name="AddressTB" Grid.Row="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Text="Телефон:" Margin="0,0,0,5"/>
        <TextBox x:Name="PhoneTB" Grid.Row="7" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Text="Email:" Margin="0,0,0,5"/>
        <TextBox x:Name="EmailTB" Grid.Row="9" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveBt_Click" Margin="0,0,10,0"/>
            <Button Content="Назад" Click="CancelBt_Click"/>
        </StackPanel>
    </Grid>
</Window>
