<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.MainPage" Title="Авторизация">

    <StackLayout VerticalOptions="Center" Padding="20">
        <Entry x:Name="LoginEntry" Placeholder="Логин" />
        <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" />
        <Button Text="Войти" x:Name="LoginButton" Clicked="LoginButton_Clicked" />
    </StackLayout>

</ContentPage>
