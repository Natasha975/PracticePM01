<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.WarehouseDetailsPage">
    <ContentPage.Content>
        
        <StackLayout Padding="20">
            <SearchBar x:Name="SearchBar" Placeholder="Поиск товара..." TextChanged="SearchBar_TextChanged"/>
            <ListView x:Name="ProductsListView" HasUnevenRows="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Padding="10">
                                <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold" />
                                <Label Text="{Binding Quantity, StringFormat='Количество: {0}'}" FontSize="Small" />
                                <Label Text="{Binding Category, StringFormat='Категория: {0}'}" FontSize="Small" />
                                <Label Text="{Binding Price, StringFormat='Цена: {0:C}'}" FontSize="Small" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
        
    </ContentPage.Content>
</ContentPage>