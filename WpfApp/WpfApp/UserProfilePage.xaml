<Page x:Class="WpfApp.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="UserProfilePage">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
                <RowDefinition Height="AUTO"/>
            </Grid.RowDefinitions>

            <Label Content="Профиль" Grid.Row="0" Grid.ColumnSpan="2" HorizontalContentAlignment="Center" FontSize="17"/>

            <Label Content="Фамилия:" Grid.Column="0" Grid.Row="1"/>
            <TextBox x:Name="LastNameTextBox" Text="{Binding Фамилия}" Margin="0,0,0,10" Width="400" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"/>

            <Label Content="Имя:" Grid.Column="0" Grid.Row="2"/>
            <TextBox x:Name="FirstNameTextBox" Text="{Binding Имя}" Margin="0,0,0,10" Grid.Column="1" Grid.Row="2"/>

            <Label Content="Отчество:" Grid.Column="0" Grid.Row="3"/>
            <TextBox x:Name="MiddleNameTextBox" Text="{Binding Отчество}" Margin="0,0,0,10" Grid.Column="1" Grid.Row="3"/>

            <Label Content="Логин:" Grid.Column="0" Grid.Row="4"/>
            <TextBox x:Name="LoginTextBox" Text="{Binding Логин}" Margin="0,0,0,10" Grid.Column="1" Grid.Row="4"/>

            <Label Content="Новый пароль:" Grid.Column="0" Grid.Row="5"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Grid.Column="1" Grid.Row="5"/>

            <Button Content="Выбрать фото" x:Name="AddPhoto" Click="AddPhoto_Click" HorizontalAlignment="Left" Margin="5" Grid.Column="0" Grid.Row="6"/>
            <Image Grid.Column="01" x:Name="PhotoIm" Grid.Row="6" Grid.RowSpan="2" Margin="120,20,120,20"  Width="300" Height="300"/>

            <Button Content="Сохранить" Click="SaveButton_Click" Width="100" HorizontalAlignment="Left" Margin="5" Grid.Column="0" Grid.Row="7"/>
        </Grid>
    </Grid>
</Page>
