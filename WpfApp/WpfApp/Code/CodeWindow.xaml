<Window x:Class="WpfApp.Code.CodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Code"
        mc:Ignorable="d"
        Title="Склад" Height="300" Width="400" WindowStartupLocation="CenterScreen" MinHeight="300" MinWidth="400">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Авторизация" Grid.Row="0" FontSize="16" HorizontalAlignment="Center" Margin="0,62,0,10"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="1" HorizontalAlignment="Center" Height="24" Margin="0,10,0,0" VerticalAlignment="Top" Width="200"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" HorizontalAlignment="Center" Height="24" Margin="0,5,0,0" VerticalAlignment="Top" Width="200"/>
        <Button x:Name="LoginButton" Grid.Row="3" Content="Войти" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="100" Click="LoginButton_Click" Height="26"/>
    </Grid>
</Window>