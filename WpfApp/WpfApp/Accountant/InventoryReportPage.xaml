<Page x:Class="WpfApp.Accountant.InventoryReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Accountant"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" >

    <Grid>
        <StackPanel Margin="10">
            <Label Content="Инвентаризация" HorizontalContentAlignment="Center" FontSize="17"/>

            <!-- Выбор товара -->
            <StackPanel Orientation="Horizontal">
                <Label Content="Выберите товар:" />
                <ComboBox x:Name="ProductComboBox" DisplayMemberPath="Название" Margin="0,5,0,10" SelectionChanged="ProductComboBox_SelectionChanged" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <!-- Ожидаемое количество -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Ожидаемое количество:" />
                    <TextBox x:Name="ExpectedQuantityTextBox" IsReadOnly="True" Margin="0,5,0,10" Width="80" />
                </StackPanel>
                
                <!-- Фактическое количество -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Фактическое количество:" />
                    <TextBox x:Name="ActualQuantityTextBox" Margin="0,5,0,10" Width="80" TextChanged="ActualQuantityTextBox_TextChanged"/>
                </StackPanel>
                
                <!-- Расхождение -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Расхождение:" />
                    <TextBox x:Name="DiscrepancyTextBox" IsReadOnly="True" Margin="0,5,0,10" Width="80" />
                </StackPanel>
            </StackPanel>
          
            <!-- Кнопка для сохранения результатов -->
            <Button Content="Сохранить результаты" Click="SaveResults_Click" Margin="0,10,0,10" />

            <!-- DataGrid для отображения результатов инвентаризации -->
            <DataGrid x:Name="InventoryDataGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Дата, StringFormat={}{0:dd.MM.yyyy}}" />
                    <DataGridTextColumn Header="Товар" Binding="{Binding Название}" />
                    <DataGridTextColumn Header="Ожидаемое количество" Binding="{Binding ОжидаемыйРез}" />
                    <DataGridTextColumn Header="Фактическое количество" Binding="{Binding ФактическийРез}" />
                    <DataGridTextColumn Header="Расхождение" Binding="{Binding Расхождение}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <!--<StackPanel Margin="10,5,10,10">

            <Label Content="Отчет по инвентаризации" HorizontalContentAlignment="Center" FontSize="17"/>

            <StackPanel Orientation="Horizontal">
                <Label Content="Поиск" Margin="0,0,0,10" />
                <TextBox x:Name="SearchTextBox" Margin="0,0,0,10" Width="300" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
            
            <DataGrid x:Name="InventoryDataGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
