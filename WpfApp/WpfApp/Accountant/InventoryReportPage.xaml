                    <DataGridTextColumn Header="Фактический результат" Binding="{Binding ФактическийРез}" />
                    <DataGridTextColumn Header="Расхождение" Binding="{Binding Расхождение}" />
                </DataGrid.Columns>
            </DataGrid>
            
        </StackPanel>-->
    </Grid>
</Page>