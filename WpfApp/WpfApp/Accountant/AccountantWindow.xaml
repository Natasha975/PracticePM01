<Window x:Class="WpfApp.Accountant.AccountantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Accountant"
        mc:Ignorable="d"
        Title="Склад" MinHeight="550" MinWidth="850" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Menu VerticalAlignment="Top">
            <MenuItem Header="Отчеты">
                <MenuItem Header="Отчет по складам" Click="OpenWarehouseReport_Click"/>
                <MenuItem Header="Отчет по оборотам" Click="OpenTurnoverReport_Click"/>
                <MenuItem Header="Отчет по остаткам" Click="OpenBalanceReport_Click"/>
                <MenuItem Header="Инвентаризация" Click="OpenInventoryReport_Click"/>
            </MenuItem>
        </Menu>

        <!-- Frame для отображения контента -->
        <Frame x:Name="MainFrame" Margin="0,40,0,0" NavigationUIVisibility="Hidden"/>

    </Grid>
    
</Window>
