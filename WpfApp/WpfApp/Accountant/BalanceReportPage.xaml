<Page x:Class="WpfApp.Accountant.BalanceReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Accountant"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" >

    <Grid>
        <StackPanel Margin="10,5,10,10">
            <Label Content="Отчет по остаткам" HorizontalContentAlignment="Center" FontSize="17"/>
            <DataGrid x:Name="BalanceDataGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Товар.Название}" />
                    <DataGridTextColumn Header="Склад" Binding="{Binding Склад.НазваниеСклада}" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Количество}" />
                </DataGrid.Columns>
            </DataGrid>
            <Label x:Name="TotalAmountTextBlock" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"/>

            <StackPanel x:Name="StockLabelsPanel" Margin="0,10,0,0">
                <!-- Label для вывода остатков добавятся динамически -->
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
