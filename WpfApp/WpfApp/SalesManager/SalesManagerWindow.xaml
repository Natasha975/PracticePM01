<Window x:Class="WpfApp.SalesManager.SalesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.SalesManager"
        mc:Ignorable="d"
        Title="Склад" MinHeight="450" MinWidth="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <Button x:Name="Ber" Margin="5" Content="Выйти из учетной записи" Click="Ber_Click" />
            <Button Content="Содержимое складов" Margin="5" x:Name="WerSee" Click="WerSee_Click"/>
            <Button Content="Формирование заказа поставщику" Margin="5" x:Name="Order" Click="Order_Click"/>
            <Button Content="Формирование заказа клиенту" Margin="5" Click="Order_Click"/>
            <Button Content="Просмотр накладных и контроль заказов" x:Name="InvoiceViewing" Click="InvoiceViewing_Click" Margin="5" />
            <Button Content="Регистрация клиента/поставщика" x:Name="RegClient" Click="RegClient_Click" Margin="5" />
            <Button x:Name="BtnProfile" Content="Профиль" Click="BtnProfile_Click" Margin="5"/>
        </StackPanel>

        <StackPanel x:Name="StackWar" Grid.Column="1" Visibility="Collapsed">
            <Label Content="Содержимое складов" HorizontalAlignment="Center" FontSize="17" Margin="5"/>
            <TreeView x:Name="treeView" Margin="5">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Товары}">
                        <TextBlock Text="{Binding НазваниеСклада}" />
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding НаименованиеТовара}" />
                                    <TextBlock Text=" - " />
                                    <TextBlock Text="{Binding Количество}" />
                                    <TextBlock Text=" кол." />
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </StackPanel>
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
