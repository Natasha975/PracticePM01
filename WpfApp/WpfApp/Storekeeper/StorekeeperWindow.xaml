<Window x:Class="WpfApp.Storekeeper.StorekeeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Storekeeper"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <Button x:Name="Ber" Content="Выйти из у/з" Click="Ber_Click" Margin="5"/>
            <Button Content="Оформление приходной и расходной накладной" Margin="5" x:Name="Invoice" Click="Invoice_Click"/>
            <Button Content="Отправка отчета по инвентаризации" Margin="5" x:Name="InventoryReport" Click="InventoryReport_Click"/>
            <Button Content="Формирование штрихкода (QR кода) товара" Margin="5" x:Name="QRCode" Click="QRCode_Click"/>
            <Button x:Name="BtnProfile" Content="Профиль" Click="BtnProfile_Click" Margin="5"/>
        </StackPanel>

        <!-- Контентная область -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
