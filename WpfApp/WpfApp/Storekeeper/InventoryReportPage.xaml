<Page x:Class="WpfApp.Storekeeper.InventoryReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Storekeeper"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InventoryReportPage">

    <Grid>
        <DataGrid x:Name="ОтчетDataGrid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название товара" Binding="{Binding НазваниеТовара}" />
                <DataGridTextColumn Header="Ожидаемый результат" Binding="{Binding ОжидаемыйРез}" />
                <DataGridTextColumn Header="Фактический результат" Binding="{Binding ФактическийРез}" />
                <DataGridTextColumn Header="Расхождение" Binding="{Binding Расхождение}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
